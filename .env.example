# DeepSeek-OCR Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8001
API_HOST=0.0.0.0

# =============================================================================
# Model Configuration
# =============================================================================
# Model identifier from HuggingFace or ModelScope
MODEL_NAME=deepseek-ai/DeepSeek-OCR

# Cache directory for downloaded models
HF_HOME=/tmp/models

# =============================================================================
# Backend Configuration
# =============================================================================
# Force specific backend (optional: mps, cuda, cpu)
# Leave empty for automatic detection
FORCE_BACKEND=

# =============================================================================
# Processing Parameters (Defaults)
# =============================================================================
# Base processing resolution (512-2048)
# Higher values = better quality but slower and more memory
BASE_SIZE=1024

# Tile size for dynamic cropping (320-1280)
# Affects memory usage for large images
IMAGE_SIZE=640

# Enable dynamic cropping for large images
CROP_MODE=true

# =============================================================================
# Feature Flags
# =============================================================================
# Enable caption generation by default
INCLUDE_CAPTION=false

# Maximum file upload size in MB
MAX_UPLOAD_SIZE_MB=100

# =============================================================================
# Performance Tuning
# =============================================================================
# Number of workers (for production deployment)
# WORKERS=1

# Enable debug logging
# DEBUG=false
